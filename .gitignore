# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.idea/
.vscode/

# 运行时产出
out/
dist/*.tmp

# 本地密钥（AMAP_KEY / TMAP_KEY 等）—— 绝不入库
.env
.env.local
.env.*.local

# 服务运行时缓存与用户上传的原图（含个人位置信息，绝不入库）
data/uploads/
data/cache/
data/last_result.json
data/last_stitch.json
data/feedback.json
data/lexicon.json.bak
data/lexicon.json.bak-*
data/lexicon.json.pre-restore-*
data/lexicon.human.json
# 轨迹模板含真实骑行位置（像素折线 ↔ 地理折线），运行期数据不入库
data/route_templates.json
data/route_templates.json.bak-*
# 由含真实轨迹的评测样本离线拟合，属运行/个人数据，不入库
data/confidence_calibration.json

# 仓库内技能安装不需要 vendor 的内核副本：scripts/recognize.py 会优先命中
# 仓库里的 src/app/。完整自包含的版本在 dist/*.zip。
.workbuddy/skills/*/assets/ride_core/

# 真实骑行数据：原始截图 / GPS 轨迹 / 轨迹可视化 —— 含个人位置信息，默认不入库。
# 克隆后把自己的截图放进 samples/ 即可运行测试；详见 samples/README.md
samples/*.jpg
samples/*.jpeg
samples/*.png
docs/*.png
docs/*.geojson
trajectory*.geojson
output/trajectory*.geojson

# 临时调试目录：诊断脚本、裁剪图、原始截图 —— 一律不入库
tmp_debug/
output/
