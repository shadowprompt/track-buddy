page {
  background: #f6f7fb;
  font-size: 32rpx;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #222;
}

.btn-primary {
  background: #1a73e8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  background: #9dbfef;
  color: #fff;
}

.btn-plain {
  background: #fff;
  color: #1a73e8;
  border: 1rpx solid #1a73e8;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.note {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.warn-text {
  font-size: 28rpx;
  color: #c05600;
  line-height: 1.6;
}
