.stats {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 33%;
  margin-bottom: 20rpx;
}

.stat-k {
  font-size: 22rpx;
  color: #999;
}

.stat-v {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-top: 4rpx;
}

.summary-wrap {
  border-top: 1rpx solid #eef0f4;
  padding-top: 20rpx;
}

.summary-title {
  font-size: 24rpx;
  color: #1a73e8;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.summary-line {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

.warn-box {
  border-top: 1rpx solid #eef0f4;
  padding-top: 16rpx;
  margin-top: 8rpx;
}

.map {
  width: 100%;
  height: 560rpx;
  border-radius: 12rpx;
}

.shot {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
}

.export-btn {
  margin-bottom: 16rpx;
  text-align: left;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field-label {
  width: 120rpx;
  color: #666;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  border-bottom: 1rpx solid #e3e6ec;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.fb-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.fb-btn {
  width: 200rpx;
  font-size: 26rpx;
  padding: 0;
  margin-right: 20rpx;
}

.fb-pos {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

.note.ok {
  color: #1a9c5b;
  margin-top: 16rpx;
}

.footer {
  padding: 20rpx 40rpx 60rpx;
}
