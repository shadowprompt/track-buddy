.hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.pick-box {
  border: 2rpx dashed #b9c6d8;
  border-radius: 12rpx;
  color: #1a73e8;
  text-align: center;
  padding: 48rpx 0;
  font-size: 30rpx;
}

.pick-box.small {
  padding: 24rpx 0;
}

.preview-wrap {
  position: relative;
}

.preview-img {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #f0f2f5;
}

.preview-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.detail-row {
  position: relative;
  display: inline-block;
  margin: 0 16rpx 16rpx 0;
}

.detail-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f2f5;
}

.detail-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: #e5484d;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field-label {
  width: 160rpx;
  color: #666;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  border-bottom: 1rpx solid #e3e6ec;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.footer {
  padding: 20rpx 40rpx 60rpx;
}

.note.err {
  color: #e5484d;
  margin-top: 16rpx;
}
